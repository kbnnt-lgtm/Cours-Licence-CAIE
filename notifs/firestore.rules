rules_version = '2';
// Règles de sécurité de la base (à coller dans Firebase › Firestore Database › Règles).
// Adresse Google de l'administrateur : kylianbonnet5986@gmail.com
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['kylianbonnet5986@gmail.com'];
    }
    // Personne exclue de la classe par l'admin (collection bannis)
    function banned() { return signedIn() && exists(/databases/$(db)/documents/bannis/$(request.auth.uid)); }
    // Compte validé par l'admin (inscrits/{uid}.statut == 'valide') : seul un compte validé peut écrire
    function valide() { return isAdmin() || (signedIn() && exists(/databases/$(db)/documents/inscrits/$(request.auth.uid))
      && get(/databases/$(db)/documents/inscrits/$(request.auth.uid)).data.statut == 'valide'); }
    function enAttente(id) { return get(/databases/$(db)/documents/demandes/$(id)).data.statut == 'en_attente'; }
    function owner(id) { return get(/databases/$(db)/documents/demandes/$(id)).data.uid == request.auth.uid; }

    // Profil, progression et stats : chacun les siens, l'admin peut lire ceux de la classe
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid && !banned() && valide()
        && request.resource.data.keys().hasOnly(['stats', 'done', 'quizBest', 'nom', 'email', 'maj'])
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
      allow delete: if isAdmin();
    }

    // Demandes de modification / ajout : créées par un membre connecté, validées par l'admin
    match /demandes/{id} {
      allow create: if signedIn() && !banned() && valide() && request.resource.data.uid == request.auth.uid
        && request.resource.data.statut == 'en_attente'
        && request.resource.data.keys().hasOnly(['uid', 'auteur', 'email', 'statut', 'type', 'matiere', 'chapitre', 'chapitreTitre', 'titre', 'texte', 'nbPhotos', 'minis', 'fichiers', 'cree'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.auteur is string && request.resource.data.auteur.size() <= 80
        && request.resource.data.type in ['cours', 'erreur', 'correction', 'photo', 'autre']
        && request.resource.data.minis is list && request.resource.data.minis.size() <= 8
        && request.resource.data.cree == request.time
        && request.resource.data.texte.size() <= 5000 && request.resource.data.titre.size() <= 120
        && request.resource.data.nbPhotos <= 8
        && (!('fichiers' in request.resource.data) || request.resource.data.fichiers.size() <= 3);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
      match /photos/{p} {
        allow create: if signedIn() && !banned() && valide() && owner(id) && enAttente(id) && p in ['0', '1', '2', '3', '4', '5', '6', '7']
          && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
        allow read: if isAdmin() || (signedIn() && owner(id));
        allow delete: if isAdmin();
      }
      // Fichiers joints (PDF, Word…), découpés en morceaux de moins de 1 Mo
      match /fichiers/{p} {
        allow create: if signedIn() && !banned() && valide() && owner(id) && enAttente(id) && p.matches('^[0-2]-[0-9]{1,2}$')
          && request.resource.data.keys().hasOnly(['data']) && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
        allow read: if isAdmin() || (signedIn() && owner(id));
        allow delete: if isAdmin();
      }
    }

    // Contenu validé et annonces : visibles par tous, écrits par l'admin
    match /contributions/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /photos/{p} { allow read: if true; allow write: if isAdmin(); }
      match /fichiers/{p} { allow read: if true; allow write: if isAdmin(); }
    }
    match /annonces/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Exclusions : écrites par l'admin ; chacun peut vérifier s'il est exclu
    match /bannis/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Inscriptions : décision de l'admin (valide / refuse) ; chacun peut lire la sienne
    match /inscrits/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }
    // Comptes en attente de validation : la personne crée sa fiche, l'admin la lit et la supprime
    match /attente/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid && !exists(/databases/$(db)/documents/inscrits/$(uid))
        && request.resource.data.keys().hasOnly(['nom', 'email', 'cree'])
        && request.resource.data.nom is string && request.resource.data.nom.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.cree == request.time;
      allow read, delete: if isAdmin();
    }

    // Tout ce qui n'est pas listé ici est refusé (lecture comme écriture).

    // Abonnements aux notifications (un document par appareil, id = jeton FCM).
    // Personne ne peut lire la liste ; l'envoi se fait côté serveur (GitHub Actions).
    match /push/{t} {
      allow create, update: if t.size() < 400 && request.resource.data.token == t
        && request.resource.data.keys().hasOnly(['token', 'uid', 'cree', 'ua'])
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow delete: if true;
    }
  }
}
